\begin{figure}[!htbp]
    \centering
    \subfloat[Global occlusion]{
    \begin{tikzpicture}[
        >=Latex,
        ray/.style={-{Latex[length=1.8mm]}, line width=0.80pt, dashed, black!85!white},
        normal/.style={-{Latex[length=1.35mm]}, line width=0.8pt, cyan!85!white},
        anglemark/.style={line width=1.05pt, magenta!85!black},
        anglelabel/.style={font=\footnotesize\bfseries, text=magenta!85!black, inner sep=0pt},
        source/.style={circle, fill=gray!80!white, draw=black, line width=0.2pt, inner sep=1.35pt},
        correct/.style={circle, fill=green!70!black, draw=black, line width=0.2pt, inner sep=1.35pt},
        filtered/.style={circle, fill=orange!95!black, draw=black, line width=0.2pt, inner sep=1.35pt},
        incorrect/.style={circle, fill=purple!85!white, draw=black, line width=0.2pt, inner sep=1.35pt},
        label/.style={font=\scriptsize, align=left, text=black, fill=white, fill opacity=0.86, text opacity=1, inner sep=0.8pt},
    ]
        \node[anchor=south west, inner sep=0] at (0,0)
            {\includegraphics[height=4.25cm, trim=360 85 360 85, clip]{figures/qi_nfp3_toroidal.png}};
        \node[source] (src) at (0.61,1.28) {};
        \node[correct] (correct) at (1.21,1.47) {};
        \node[filtered] (filtered) at (3.05,2.03) {};
        \node[incorrect] (incorrect) at (3.92,2.33) {};
        \draw[ray, shorten >=2.6pt] (src) -- (correct);
        \draw[ray, shorten <=2.6pt, shorten >=2.6pt] (correct) -- (filtered);
        \draw[ray, shorten <=2.6pt] (filtered) -- (incorrect);
        \draw[ray, -] (incorrect) -- ++(19.0:0.34);
        \draw[normal] (correct) -- (1.636,1.820);
        \draw[normal] (filtered) -- (2.498,2.025);
        \draw[normal] (incorrect) -- (4.468,2.260);
        \draw[anglemark] (incorrect) ++(-7.2:0.28) arc[start angle=-7.2, end angle=19.0, radius=0.28];
        \node[anglelabel] at (4.42,2.39) {$\gamma$};
        \node[label] at (1.67,1.96) {$\mathbf{n}_{w_1}$};
        \node[label, below left=0pt of src] {$\mathbf{x}$};
        \node[label, below=2pt of correct, xshift=1.8pt] {$\mathbf{x}_{w_1}$};
        \node[label, below=2pt of filtered] {$\mathbf{x}_{w_2}$};
        \node[label, above left=0pt of incorrect] {$\mathbf{x}_{w_3}$};
    \end{tikzpicture}
    }
    \hspace{1.0cm}
    \subfloat[Self-shadowing]{
    \begin{tikzpicture}[
        >=Latex,
        ray/.style={-{Latex[length=1.8mm]}, line width=0.80pt, dashed, black!85!white},
        normal/.style={-{Latex[length=1.35mm]}, line width=0.8pt, cyan!85!white},
        anglemark/.style={line width=1.05pt, magenta!85!black},
        anglelabel/.style={font=\footnotesize\bfseries, text=magenta!85!black, inner sep=0pt},
        source/.style={circle, fill=gray!80!white, draw=black, line width=0.2pt, inner sep=1.35pt},
        correct/.style={circle, fill=green!70!black, draw=black, line width=0.2pt, inner sep=1.35pt},
        filtered/.style={circle, fill=orange!95!black, draw=black, line width=0.2pt, inner sep=1.35pt},
        incorrect/.style={circle, fill=purple!85!white, draw=black, line width=0.2pt, inner sep=1.35pt},
        label/.style={font=\scriptsize, align=left, text=black, fill=white, fill opacity=0.86, text opacity=1, inner sep=0.8pt},
    ]
        \node[anchor=south west, inner sep=0] at (0,0)
            {\includegraphics[height=4.25cm, trim=460 35 455 35, clip]{figures/poloidal.png}};

        \node[source] (src) at (0.76,0.91) {};
        \node[correct] (correct) at (0.68,1.67) {};
        \node[filtered] (filtered) at (0.54,2.82) {};
        \node[incorrect] (incorrect) at (0.41,4.07) {};

        \draw[ray, shorten >=2.6pt] (src) -- (correct);
        \draw[ray, shorten <=2.6pt, shorten >=2.6pt] (correct) -- (filtered);
        \draw[ray, shorten <=2.6pt] (filtered) -- (incorrect);
        \draw[normal] (correct) -- (0.271,2.040);
        \draw[normal] (filtered) -- (0.091,2.503);
        \draw[normal] (incorrect) -- (0.067,4.506);
        \draw[anglemark] (filtered) ++(96.6:0.24) arc[start angle=96.6, end angle=215.2, radius=0.24];
        \node[anglelabel] at (0.22,2.94) {$\gamma$};

        \node[label, below=1pt of src] {$\mathbf{x}$};
        \node[label, right=1pt of correct] {$\mathbf{x}_{w_1}$ valid score};
        \node[label, right=1pt of filtered] {$\mathbf{x}_{w_2}$ filtered score\\with $\cos\gamma<0$};
        \node[label, right=1pt of incorrect] {$\mathbf{x}_{w_3}$ invalid score};
    \end{tikzpicture}
    }
    \caption{Visibility failures in the deterministic line-of-sight wall-loading model. Gray marks the source point, green a valid wall contribution, orange a locally back-facing point rejected by $\cos\gamma<0$, and red a false positive retained by the local test. Panel (a) shows global occlusion by an intervening wall segment; panel (b) shows self-shadowing in a shaped poloidal cross-section. Cyan arrows denote wall normals and magenta arcs indicate $\gamma$.}
    \label{fig:visibility-schematic}
\end{figure}
